# .env.example — copy to .env and fill in your real keys.
# .env is in .gitignore. DO NOT COMMIT your real .env.

# OpenAQ v3 API key. Register free at https://explore.openaq.org/register
# Without a key you get the anonymous tier (~10 req/min); with a key it's
# ~10× faster and more reliable.
OPENAQ_KEY=

# Optional override for the US Consulate Karachi OpenAQ sensor ID.
# Default in script/stations.json is 225442. Verify at
# https://openaq.org/location/225442 that the sensor is still active.
OPENAQ_US_CONSULATE_ID=225442

# Google Earth Engine project ID. Must be a registered GEE project
# (Cloud project with Earth Engine API enabled).
# After `earthengine authenticate`, you can also set it with:
#   earthengine set_project <project_id>
GEE_PROJECT=gen-lang-client-0478151371
